  const skillsGraph = document.querySelector(".skills-graph");
  const skillsDataEl = document.getElementById("skills-data");
  let skillsGraphFrame = null;

  if (skillsGraph && skillsDataEl) {
    let skillsData = null;
    try {
      skillsData = JSON.parse(skillsDataEl.textContent);
    } catch (err) {
      skillsData = null;
    }

    if (skillsData) {
      const skillsList = skillsGraph.querySelector("[data-skills-list]");
      const projectsList = skillsGraph.querySelector("[data-projects-list]");
      const linesSvg = skillsGraph.querySelector(".skills-graph__lines");

      if (skillsList && projectsList && linesSvg) {
        const topSkills = Array.isArray(skillsData.skills)
          ? skillsData.skills
          : [];
        const projects = Array.isArray(skillsData.projects)
          ? skillsData.projects
          : [];

        const topSkillMap = new Map();

        topSkills.forEach((skill) => {
          const skillId = String(skill.id);
          topSkillMap.set(skillId, skill);
        });

        const projectData = projects.map((project) => ({
          ...project,
          id: String(project.id),
          categories: (project.categories || []).map((id) => String(id)),
        }));

        const projectById = new Map();
        projectData.forEach((project) => {
          project.categorySet = new Set(project.categories);
          projectById.set(project.id, project);
        });

        const topSkillDescendants = new Map();
        topSkills.forEach((skill) => {
          const ids = new Set([String(skill.id)]);
          (skill.children || []).forEach((child) => ids.add(String(child.id)));
          topSkillDescendants.set(String(skill.id), ids);
        });

        let currentMode = "top";
        let activeParentId = null;

        const getCurrentSkills = () => {
          if (currentMode === "top") {
            return topSkills;
          }
          const parentSkill = topSkillMap.get(String(activeParentId));
          return parentSkill ? parentSkill.children || [] : [];
        };

        const isProjectConnectedToSkill = (project, skillId) => {
          const skillKey = String(skillId);
          if (currentMode === "top") {
            const descendants = topSkillDescendants.get(skillKey);
            if (!descendants) {
              return false;
            }
            return project.categories.some((catId) => descendants.has(catId));
          }
          return project.categorySet.has(skillKey);
        };

        const clearActiveState = () => {
          skillsGraph.classList.remove("skills-graph--active");
          skillsGraph
            .querySelectorAll(".is-connected")
            .forEach((el) => el.classList.remove("is-connected"));
        };

        const updateParentProjectFilter = () => {
          const isSubMode = currentMode === "sub" && activeParentId;
          skillsGraph.classList.toggle("skills-graph--subfilter", isSubMode);
          skillsGraph.classList.toggle("skills-graph--submode", isSubMode);
          const parentKey = String(activeParentId || "");
          const parentDescendants = topSkillDescendants.get(parentKey) || new Set();

          projectsList
            .querySelectorAll(".skills-graph__item[data-project-id]")
            .forEach((item) => {
              const projectId = item.dataset.projectId;
              const project = projectById.get(String(projectId));
              const isConnected =
                !!project &&
                project.categories.some((catId) => parentDescendants.has(catId));
              item.classList.toggle("is-parent-connected", isConnected);
            });
        };

        const markActiveState = ({ skillId, projectId }) => {
          if (!skillId && !projectId) {
            clearActiveState();
            return;
          }

          const connectedSkillIds = new Set();
          const connectedProjectIds = new Set();

          if (skillId) {
            const skillKey = String(skillId);
            connectedSkillIds.add(skillKey);
            projectData.forEach((project) => {
              if (isProjectConnectedToSkill(project, skillKey)) {
                connectedProjectIds.add(project.id);
              }
            });
          } else if (projectId) {
            const projectKey = String(projectId);
            const project = projectById.get(projectKey);
            if (project) {
              connectedProjectIds.add(project.id);
              if (currentMode === "top") {
                topSkills.forEach((skill) => {
                  if (isProjectConnectedToSkill(project, skill.id)) {
                    connectedSkillIds.add(String(skill.id));
                  }
                });
              } else {
                getCurrentSkills().forEach((skill) => {
                  if (project.categorySet.has(String(skill.id))) {
                    connectedSkillIds.add(String(skill.id));
                  }
                });
              }
            }
          }

          skillsGraph.classList.add("skills-graph--active");

          skillsList
            .querySelectorAll(".skills-graph__item[data-skill-id]")
            .forEach((item) => {
              const id = item.dataset.skillId;
              item.classList.toggle("is-connected", connectedSkillIds.has(id));
            });

          projectsList
            .querySelectorAll(".skills-graph__item[data-project-id]")
            .forEach((item) => {
              const id = item.dataset.projectId;
              item.classList.toggle("is-connected", connectedProjectIds.has(id));
            });

          linesSvg
            .querySelectorAll(".skills-graph__line")
            .forEach((line) => {
              const lineSkillId = line.dataset.skillId;
              const lineProjectId = line.dataset.projectId;
              const isConnected =
                connectedSkillIds.has(lineSkillId) &&
                connectedProjectIds.has(lineProjectId);
              line.classList.toggle("is-connected", isConnected);
            });
        };

        const bindProjectHover = () => {
          projectsList
            .querySelectorAll(".skills-graph__link[data-project-id]")
            .forEach((link) => {
              const projectId = link.dataset.projectId;
              const enter = () => markActiveState({ projectId });
              const leave = () => clearActiveState();
              link.addEventListener("mouseenter", enter);
              link.addEventListener("focusin", enter);
              link.addEventListener("mouseleave", leave);
              link.addEventListener("focusout", leave);
            });
        };

        const bindSkillHover = () => {
          skillsList
            .querySelectorAll(".skills-graph__link[data-skill-id]")
            .forEach((link) => {
              const hasChildren = link.dataset.hasChildren === "true";
              const isConnected = link.dataset.connected === "true";
              if (!hasChildren && !isConnected) {
                return;
              }
              const skillId = link.dataset.skillId;
              const enter = () => markActiveState({ skillId });
              const leave = () => clearActiveState();
              link.addEventListener("mouseenter", enter);
              link.addEventListener("focusin", enter);
              link.addEventListener("mouseleave", leave);
              link.addEventListener("focusout", leave);
            });
        };

        const renderSkillsList = (options = {}) => {
          const currentSkills = getCurrentSkills();
          const fragment = document.createDocumentFragment();

          if (currentMode === "sub") {
            const backItem = document.createElement("li");
            backItem.className = "skills-graph__item skills-graph__item--back";
            const backLink = document.createElement("a");
            backLink.className = "skills-graph__link";
            backLink.href = "#";
            backLink.dataset.action = "back";
            backLink.textContent = "back";
            backItem.appendChild(backLink);
            fragment.appendChild(backItem);
          }

          currentSkills.forEach((skill) => {
            const item = document.createElement("li");
            item.className = "skills-graph__item";
            item.dataset.skillId = String(skill.id);

            const hasChildren =
              currentMode === "top" && skill.children && skill.children.length;
            const isStatic = !hasChildren;
            const isConnected = projectData.some((project) =>
              isProjectConnectedToSkill(project, skill.id)
            );

            const link = document.createElement("a");
            link.className = `skills-graph__link${isStatic ? " skills-graph__link--static" : ""}`;
            link.href = "#";
            if (skill.url) {
              link.dataset.previewUrl = skill.url;
            }
            link.dataset.skillId = String(skill.id);
            link.dataset.hasChildren = hasChildren ? "true" : "false";
            link.dataset.connected = isConnected ? "true" : "false";
            if (isStatic) {
              link.dataset.static = "true";
              link.setAttribute("aria-disabled", "true");
            }
            const label = skill.name || "";
            if (currentMode === "top") {
              const strong = document.createElement("strong");
              strong.textContent = label.slice(0, 4);
              link.appendChild(strong);
              link.appendChild(document.createTextNode(label.slice(4)));
            } else {
              link.textContent = label;
            }

            item.appendChild(link);
            fragment.appendChild(item);
          });

          skillsList.replaceChildren(fragment);
          bindSkillHover();

          if (options.animate) {
            window.requestAnimationFrame(() => {
              skillsList.classList.add("skills-graph__list--visible");
            });
          } else {
            skillsList.classList.add("skills-graph__list--visible");
          }

          updateParentProjectFilter();
