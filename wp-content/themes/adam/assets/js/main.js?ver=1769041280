// Starter JS file.
// Later: add hover-expand + panel preview + transition logic here.
console.log("theme js loaded");

document.addEventListener("DOMContentLoaded", () => {
  const root = document.documentElement;
  const prefersReducedMotion = window.matchMedia
    ? window.matchMedia("(prefers-reduced-motion: reduce)").matches
    : false;
  const getFadeDuration = () => {
    const raw = window
      .getComputedStyle(root)
      .getPropertyValue("--page-fade-duration")
      .trim();
    if (!raw) {
      return 280;
    }
    const value = parseFloat(raw);
    if (Number.isNaN(value)) {
      return 280;
    }
    if (raw.endsWith("ms")) {
      return value;
    }
    if (raw.endsWith("s")) {
      return value * 1000;
    }
    return value;
  };
  const clearPageTransition = () => {
    root.classList.remove("page-transition-init");
    root.classList.remove("page-transition-out");
  };

  if (!prefersReducedMotion) {
    window.requestAnimationFrame(() => {
      root.classList.remove("page-transition-init");
    });

    window.addEventListener("pageshow", clearPageTransition);

    document.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0) {
        return;
      }
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }

      const link = event.target.closest("a");
      if (!link) {
        return;
      }
      if (link.target && link.target.toLowerCase() !== "_self") {
        return;
      }
      if (link.hasAttribute("download")) {
        return;
      }
      const href = link.getAttribute("href");
      if (!href || href.startsWith("#")) {
        return;
      }

      let url = null;
      try {
        url = new URL(link.href, window.location.href);
      } catch (err) {
        return;
      }
      if (url.origin !== window.location.origin) {
        return;
      }
      const current = window.location.href.replace(/#.*$/, "");
      const next = url.href.replace(/#.*$/, "");
      if (current === next) {
        return;
      }

      event.preventDefault();
      root.classList.add("page-transition-out");
      window.setTimeout(() => {
        window.location.href = url.href;
      }, getFadeDuration());
    });
  }

  const themeToggle = document.querySelector("[data-theme-toggle]");
  const themeStorageKey = "adam-theme";
  const getPreferredTheme = () => {
    try {
      const stored = window.localStorage.getItem(themeStorageKey);
      if (stored === "light" || stored === "dark") {
        return stored;
      }
    } catch (err) {
      /* ignore */
    }
    return "light";
  };

  const updateToggleLabel = (theme) => {
    if (!themeToggle) {
      return;
    }
    const label = theme === "dark" ? "Light mode" : "Dark mode";
    themeToggle.textContent = label;
    themeToggle.setAttribute("aria-label", label);
  };

  const applyTheme = (theme) => {
    root.setAttribute("data-theme", theme);
    updateToggleLabel(theme);
  };

  applyTheme(getPreferredTheme());

  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const current = root.getAttribute("data-theme") === "dark" ? "dark" : "light";
      const next = current === "dark" ? "light" : "dark";
      applyTheme(next);
      try {
        window.localStorage.setItem(themeStorageKey, next);
      } catch (err) {
        /* ignore */
      }
      if (aboutConnector) {
        if (aboutConnectorFrame) {
          cancelAnimationFrame(aboutConnectorFrame);
        }
        aboutConnectorFrame = requestAnimationFrame(updateAboutConnector);
      }
      if (heroConnector) {
        if (heroConnectorFrame) {
          cancelAnimationFrame(heroConnectorFrame);
        }
        heroConnectorFrame = requestAnimationFrame(updateHeroConnector);
      }
    });
  }

  const headerLinks = document.querySelectorAll(
    ".header-menu__nav .header-menu__link, .header-menu__link--back, .header-menu__first .header-menu__link"
  );
  let navPreview = null;
  let navFrame = null;
  let navIframe = null;
  let navImage = null;
  let navCard = null;
  let activeNavLink = null;
  let navHideTimeout = null;
  let navFallbackTimeout = null;
  const previewCache = new Map();
  const screenshotCache = new Map();
  let navScreenshotToken = 0;
  const isSafari = (() => {
    const ua = navigator.userAgent || "";
    const vendor = navigator.vendor || "";
    return /Safari/.test(ua) &&
      !/Chrome|Chromium|Edg|OPR|Brave|CriOS/.test(ua) &&
      /Apple/.test(vendor);
  })();

  const isExternalLink = (link) => {
    if (!link || !link.href) {
      return false;
    }
    try {
      const url = new URL(link.href, window.location.href);
      return url.origin !== window.location.origin;
    } catch (err) {
      return false;
    }
  };

  const isPreviewEligible = (link) => {
    if (!link) {
      return false;
    }
    if (link.closest(".card, .projects-list, .grid, .project, .project-card")) {
      return false;
    }
    if (link.closest(".nav-preview, .content-preview")) {
      return false;
    }
    return true;
  };

  const getScreenshotUrl = (url, width, height) => {
    const ajaxUrl = window.adamTheme?.ajaxUrl;
    const nonce = window.adamTheme?.previewNonce;
    if (!ajaxUrl || !nonce) {
      return "";
    }
    const captureWidth = 1440;
    const captureHeight = 900;
    const previewVersion = "2";
    const params = new URLSearchParams({
      action: "adam_link_screenshot",
      url,
      nonce,
      w: String(width),
      h: String(height),
      cw: String(captureWidth),
      ch: String(captureHeight),
      v: previewVersion,
    });
    return `${ajaxUrl}?${params.toString()}`;
  };

  const getScreenshotBlobUrl = (url, width, height) => {
    const cacheKey = `${url}|${width}x${height}`;
    if (screenshotCache.has(cacheKey)) {
      return screenshotCache.get(cacheKey);
    }
    const requestUrl = getScreenshotUrl(url, width, height);
    if (!requestUrl) {
      const fallback = Promise.reject(new Error("Missing screenshot endpoint."));
      screenshotCache.set(cacheKey, fallback);
      return fallback;
    }
    if (isSafari) {
      const request = Promise.resolve(requestUrl);
      screenshotCache.set(cacheKey, request);
      const preload = new Image();
      preload.src = requestUrl;
      return request;
    }
    const fetchScreenshot = () =>
      fetch(requestUrl, { credentials: "same-origin" })
        .then((res) => {
          if (!res.ok) {
            throw new Error("Screenshot request failed.");
          }
          const contentType = res.headers.get("content-type") || "";
          if (contentType && !contentType.startsWith("image/")) {
            throw new Error("Invalid screenshot content type.");
          }
          return res.blob();
        })
        .then((blob) => {
          if (!blob.size) {
            throw new Error("Empty screenshot response.");
          }
          return URL.createObjectURL(blob);
        });

    const request = fetchScreenshot()
      .catch(() => fetchScreenshot())
      .catch((err) => {
        screenshotCache.delete(cacheKey);
        throw err;
      });
    screenshotCache.set(cacheKey, request);
    return request;
  };

  const getPreviewData = (url) => {
    if (previewCache.has(url)) {
      return previewCache.get(url);
    }

    const ajaxUrl = window.adamTheme?.ajaxUrl;
    const nonce = window.adamTheme?.previewNonce;
    if (!ajaxUrl || !nonce) {
      const fallback = Promise.resolve({
        title: url,
        description: "",
        image: "",
        siteName: "",
        url,
      });
      previewCache.set(url, fallback);
      return fallback;
    }

    const payload = new URLSearchParams({
      action: "adam_link_preview",
      url,
      nonce,
    });

    const request = fetch(ajaxUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
      },
      body: payload.toString(),
      credentials: "same-origin",
    })
      .then((res) => res.json())
      .then((data) => {
        if (data && data.success && data.data) {
          return data.data;
        }
        return {
          title: url,
          description: "",
          image: "",
          siteName: "",
          url,
        };
      })
      .catch(() => ({
        title: url,
        description: "",
        image: "",
        siteName: "",
        url,
      }));

    previewCache.set(url, request);
    return request;
  };

  const applyPreviewFallback = (prefix, previewEl, cardEl, imageEl, url) => {
    if (!previewEl || !imageEl) {
      return;
    }
    const base = `${prefix}-preview`;
    previewEl.classList.remove(
      `${base}--image`,
      `${base}--screenshot`,
      `${base}--loading`
    );
    previewEl.classList.add(`${base}--fallback`);
    imageEl.removeAttribute("src");

    if (!cardEl) {
      return;
    }

    const titleEl = cardEl.querySelector(".link-preview-card__title");
    const descEl = cardEl.querySelector(".link-preview-card__description");
    const hostEl = cardEl.querySelector(".link-preview-card__host");
    getPreviewData(url)
      .then((data) => {
        const host = (() => {
          try {
            const parsed = new URL(url);
            return parsed.hostname.replace(/^www\./, "");
          } catch (err) {
            return "";
          }
        })();
        if (titleEl) {
          titleEl.textContent = data.title || host || url;
        }
        if (descEl) {
          descEl.textContent = data.description || "";
        }
        if (hostEl) {
          hostEl.textContent = data.siteName || host;
        }
        if (data.image) {
          imageEl.onload = () => {
            previewEl.classList.add(`${base}--image`);
            previewEl.classList.remove(`${base}--fallback`);
          };
          imageEl.onerror = () => {};
          imageEl.src = data.image;
          previewEl.classList.add(`${base}--external`);
        }
      })
      .catch(() => {});
  };

  const ensureNavPreview = () => {
    if (navPreview) {
      return;
    }

    navPreview = document.createElement("div");
    navPreview.className = "nav-preview";
    navPreview.innerHTML = `
      <div class="nav-preview__frame">
        <iframe class="nav-preview__iframe" title="Page preview" loading="lazy"></iframe>
        <img class="nav-preview__image" alt="" loading="lazy">
        <div class="link-preview-card nav-preview__card" aria-hidden="true">
          <div class="link-preview-card__text">
            <p class="link-preview-card__title"></p>
            <p class="link-preview-card__description"></p>
            <p class="link-preview-card__host"></p>
          </div>
          <div class="link-preview-card__thumb"></div>
        </div>
      </div>
    `;
    document.body.appendChild(navPreview);
    navFrame = navPreview.querySelector(".nav-preview__frame");
    navIframe = navPreview.querySelector(".nav-preview__iframe");
    navImage = navPreview.querySelector(".nav-preview__image");
    navCard = navPreview.querySelector(".nav-preview__card");
  };

  const resetNavPreviewState = () => {
    if (!navPreview || !navImage) {
      return;
    }
    navPreview.classList.remove(
      "nav-preview--external",
      "nav-preview--card",
      "nav-preview--image",
      "nav-preview--screenshot",
      "nav-preview--loading",
      "nav-preview--fallback"
    );
    navImage.onload = null;
    navImage.onerror = null;
    navImage.removeAttribute("src");
  };

  const positionNavPreview = (link) => {
    if (!navPreview || !navFrame) {
      return;
    }

    const rect = link.getBoundingClientRect();
    const frameWidth = navFrame.offsetWidth || 360;
    const frameHeight = navFrame.offsetHeight || 240;
    const margin = 12;

    const maxLeft = window.innerWidth - frameWidth - margin;
    const left = Math.min(maxLeft, Math.max(margin, rect.right - frameWidth));
    const maxTop = window.innerHeight - frameHeight - margin;
    const top = Math.min(maxTop, Math.max(margin, rect.bottom + margin));

    navPreview.style.left = `${left}px`;
    navPreview.style.top = `${top}px`;
  };

  const showNavPreview = (link) => {
    if (!link || !link.href) {
      return;
    }

    ensureNavPreview();
    if (!navPreview || !navIframe || !navImage) {
      return;
    }

    resetNavPreviewState();

    if (navHideTimeout) {
      window.clearTimeout(navHideTimeout);
      navHideTimeout = null;
    }
    if (navFallbackTimeout) {
      window.clearTimeout(navFallbackTimeout);
      navFallbackTimeout = null;
    }

    const url = link.href;
    activeNavLink = link;
    if (isExternalLink(link)) {
      navIframe.removeAttribute("src");
      navIframe.dataset.src = "";
      navPreview.classList.add("nav-preview--external");
      navPreview.classList.add("nav-preview--loading");
      if (url.includes("linkedin.com")) {
        const themeUrl = window.adamTheme?.themeUrl || "";
        navImage.src = themeUrl
          ? `${themeUrl}/assets/img/linkedinhover.png`
          : "/wp-content/themes/adambasic/assets/img/linkedinhover.png";
        navPreview.classList.add("nav-preview--image", "nav-preview--screenshot");
        navPreview.classList.remove("nav-preview--loading");
      } else {
      const currentToken = ++navScreenshotToken;
      const isCurrent = () => currentToken === navScreenshotToken && activeNavLink === link;
      navFallbackTimeout = window.setTimeout(() => {
        if (!isCurrent()) {
          return;
        }
        if (navPreview.classList.contains("nav-preview--loading")) {
          applyPreviewFallback("nav", navPreview, navCard, navImage, url);
        }
      }, 2200);
      navImage.onerror = () => {
        if (!isCurrent()) {
          return;
        }
        if (navFallbackTimeout) {
          window.clearTimeout(navFallbackTimeout);
          navFallbackTimeout = null;
        }
        applyPreviewFallback("nav", navPreview, navCard, navImage, url);
      };
      navImage.onload = () => {
        if (!isCurrent()) {
          return;
        }
        if (navFallbackTimeout) {
          window.clearTimeout(navFallbackTimeout);
          navFallbackTimeout = null;
        }
        navPreview.classList.add("nav-preview--image", "nav-preview--screenshot");
        navPreview.classList.remove("nav-preview--loading");
      };
      getScreenshotBlobUrl(url, 360, 225)
        .then((blobUrl) => {
          if (!isCurrent()) {
            return;
          }
          navImage.src = blobUrl;
          navImage.decode?.()
            .then(() => {
              if (!isCurrent()) {
                return;
              }
              navPreview.classList.add("nav-preview--image", "nav-preview--screenshot");
              navPreview.classList.remove("nav-preview--loading");
            })
            .catch(() => {});
        })
        .catch(() => {
          if (!isCurrent()) {
            return;
          }
          if (navFallbackTimeout) {
            window.clearTimeout(navFallbackTimeout);
            navFallbackTimeout = null;
          }
          applyPreviewFallback("nav", navPreview, navCard, navImage, url);
        });
      }
    } else {
      if (navIframe.dataset.src !== url) {
        navIframe.dataset.src = url;
        navIframe.src = url;
      }
    }

    positionNavPreview(link);
    window.requestAnimationFrame(() => {
      if (activeNavLink === link) {
        navPreview.classList.add("nav-preview--visible");
      }
    });
  };

  const hideNavPreview = () => {
    if (!navPreview) {
      return;
    }

    navHideTimeout = window.setTimeout(() => {
      navPreview.classList.remove("nav-preview--visible");
      activeNavLink = null;
    }, 80);
  };

  if (headerLinks.length) {
    headerLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => showNavPreview(link));
      link.addEventListener("focusin", () => showNavPreview(link));
      link.addEventListener("mouseleave", hideNavPreview);
      link.addEventListener("focusout", hideNavPreview);
    });

    window.addEventListener("scroll", () => {
      if (activeNavLink) {
        positionNavPreview(activeNavLink);
      }
    }, { passive: true });
    window.addEventListener("resize", () => {
      if (activeNavLink) {
        positionNavPreview(activeNavLink);
      }
    });
  }

  const contentLinks = document.querySelectorAll("main a");
  let contentPreview = null;
  let contentFrame = null;
  let contentIframe = null;
  let contentImage = null;
  let contentCard = null;
  let activeContentLink = null;
  let contentHideTimeout = null;
  let contentFallbackTimeout = null;
  let contentScreenshotToken = 0;

  const ensureContentPreview = () => {
    if (contentPreview) {
      return;
    }

    contentPreview = document.createElement("div");
    contentPreview.className = "content-preview";
    contentPreview.innerHTML = `
      <div class="content-preview__frame">
        <iframe class="content-preview__iframe" title="Link preview" loading="lazy"></iframe>
        <img class="content-preview__image" alt="" loading="lazy">
        <div class="link-preview-card content-preview__card" aria-hidden="true">
          <div class="link-preview-card__text">
            <p class="link-preview-card__title"></p>
            <p class="link-preview-card__description"></p>
            <p class="link-preview-card__host"></p>
          </div>
          <div class="link-preview-card__thumb"></div>
        </div>
      </div>
    `;
    document.body.appendChild(contentPreview);
    contentFrame = contentPreview.querySelector(".content-preview__frame");
    contentIframe = contentPreview.querySelector(".content-preview__iframe");
    contentImage = contentPreview.querySelector(".content-preview__image");
    contentCard = contentPreview.querySelector(".content-preview__card");
  };

  const resetContentPreviewState = () => {
    if (!contentPreview || !contentImage) {
      return;
    }
    contentPreview.classList.remove(
      "content-preview--external",
      "content-preview--card",
      "content-preview--image",
      "content-preview--screenshot",
      "content-preview--loading",
      "content-preview--fallback"
    );
    contentImage.onload = null;
    contentImage.onerror = null;
    contentImage.removeAttribute("src");
  };

  const positionContentPreview = (link) => {
    if (!contentPreview || !contentFrame) {
      return;
    }

    const rect = link.getBoundingClientRect();
    const frameWidth = contentFrame.offsetWidth || 280;
    const frameHeight = contentFrame.offsetHeight || 190;
    const margin = 12;

    if (link.closest(".skills-graph")) {
      let left = rect.right + margin;
      left = Math.min(
        window.innerWidth - frameWidth - margin,
        Math.max(margin, left)
      );

      let top = rect.top + rect.height / 2 - frameHeight / 2;
      top = Math.min(
        window.innerHeight - frameHeight - margin,
        Math.max(margin, top)
      );

      contentPreview.style.left = `${left}px`;
      contentPreview.style.top = `${top}px`;
      return;
    }

    let left = rect.left + rect.width / 2 - frameWidth / 2;
    left = Math.min(
      window.innerWidth - frameWidth - margin,
      Math.max(margin, left)
    );

    let top = rect.top - frameHeight - margin;

    contentPreview.style.left = `${left}px`;
    contentPreview.style.top = `${top}px`;
  };

  const showContentPreview = (link) => {
    if (document.body.classList.contains("page-more")) {
      return;
    }
    if (!link) {
      return;
    }
    if (!isPreviewEligible(link)) {
      return;
    }

    const rawHref = link.getAttribute("href");
    const previewUrl = link.dataset.previewUrl || link.href || "";
    if (
      (!previewUrl && !rawHref) ||
      (!link.dataset.previewUrl && rawHref && rawHref.startsWith("#")) ||
      (rawHref && rawHref.startsWith("mailto:")) ||
      (rawHref && rawHref.startsWith("tel:"))
    ) {
      return;
    }

    ensureContentPreview();
    if (!contentPreview || !contentIframe || !contentImage) {
      return;
    }

    resetContentPreviewState();

    if (contentHideTimeout) {
      window.clearTimeout(contentHideTimeout);
      contentHideTimeout = null;
    }
    if (contentFallbackTimeout) {
      window.clearTimeout(contentFallbackTimeout);
      contentFallbackTimeout = null;
    }

    const url = previewUrl;
    activeContentLink = link;
    if (isExternalLink(link)) {
      contentIframe.removeAttribute("src");
      contentIframe.dataset.src = "";
      contentPreview.classList.add("content-preview--external");
      contentPreview.classList.remove(
        "content-preview--card",
        "content-preview--image",
        "content-preview--screenshot"
      );
      contentPreview.classList.add("content-preview--loading");
      contentImage.removeAttribute("src");
      if (url.includes("linkedin.com")) {
        const themeUrl = window.adamTheme?.themeUrl || "";
        contentImage.src = themeUrl
          ? `${themeUrl}/assets/img/linkedinhover.png`
          : "/wp-content/themes/adambasic/assets/img/linkedinhover.png";
        contentPreview.classList.add("content-preview--image", "content-preview--screenshot");
        contentPreview.classList.remove("content-preview--loading");
      } else {
      const currentToken = ++contentScreenshotToken;
      const isCurrent = () => currentToken === contentScreenshotToken && activeContentLink === link;
      contentFallbackTimeout = window.setTimeout(() => {
        if (!isCurrent()) {
          return;
        }
        if (contentPreview.classList.contains("content-preview--loading")) {
          applyPreviewFallback("content", contentPreview, contentCard, contentImage, url);
        }
      }, 2200);
      contentImage.onerror = () => {
        if (!isCurrent()) {
          return;
        }
        if (contentFallbackTimeout) {
          window.clearTimeout(contentFallbackTimeout);
          contentFallbackTimeout = null;
        }
        applyPreviewFallback("content", contentPreview, contentCard, contentImage, url);
      };
      contentImage.onload = () => {
        if (!isCurrent()) {
          return;
        }
        if (contentFallbackTimeout) {
          window.clearTimeout(contentFallbackTimeout);
          contentFallbackTimeout = null;
        }
        contentPreview.classList.add("content-preview--image", "content-preview--screenshot");
        contentPreview.classList.remove("content-preview--loading");
      };
      getScreenshotBlobUrl(url, 280, 175)
        .then((blobUrl) => {
          if (!isCurrent()) {
            return;
          }
          contentImage.src = blobUrl;
          contentImage.decode?.()
            .then(() => {
              if (!isCurrent()) {
                return;
              }
              contentPreview.classList.add("content-preview--image", "content-preview--screenshot");
              contentPreview.classList.remove("content-preview--loading");
            })
            .catch(() => {});
        })
        .catch(() => {
          if (!isCurrent()) {
            return;
          }
          if (contentFallbackTimeout) {
            window.clearTimeout(contentFallbackTimeout);
            contentFallbackTimeout = null;
          }
          applyPreviewFallback("content", contentPreview, contentCard, contentImage, url);
        });
      }
    } else {
      contentPreview.classList.remove("content-preview--external");
      contentPreview.classList.remove("content-preview--fallback");
      contentPreview.classList.remove("content-preview--card");
      contentImage.removeAttribute("src");
      contentPreview.classList.remove("content-preview--image");
      if (contentIframe.dataset.src !== url) {
        contentIframe.dataset.src = url;
        contentIframe.src = url;
      }
    }

    positionContentPreview(link);
    window.requestAnimationFrame(() => {
      if (activeContentLink === link) {
        contentPreview.classList.add("content-preview--visible");
      }
    });
  };

  const hideContentPreview = () => {
    if (!contentPreview) {
      return;
    }

    contentHideTimeout = window.setTimeout(() => {
      contentPreview.classList.remove("content-preview--visible");
      activeContentLink = null;
    }, 80);
  };

  if (contentLinks.length) {
    contentLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => showContentPreview(link));
      link.addEventListener("focusin", () => showContentPreview(link));
      link.addEventListener("mouseleave", hideContentPreview);
      link.addEventListener("focusout", hideContentPreview);
    });

    window.addEventListener("scroll", () => {
      if (activeContentLink) {
        positionContentPreview(activeContentLink);
      }
    }, { passive: true });
    window.addEventListener("resize", () => {
      if (activeContentLink) {
        positionContentPreview(activeContentLink);
      }
    });
  }

  const preloadExternalPreviews = () => {
    const linkSet = new Set();
    const eligible = [];
    document.querySelectorAll("a[href]").forEach((link) => {
      if (!isExternalLink(link)) {
        return;
      }
      if (!isPreviewEligible(link) && !link.closest(".header-menu")) {
        return;
      }
      const href = link.href;
      if (href.includes("linkedin.com")) {
        return;
      }
      if (linkSet.has(href)) {
        return;
      }
      linkSet.add(href);
      eligible.push(href);
    });

    const queue = [...eligible];
    const runNext = () => {
      const next = queue.shift();
      if (!next) {
        return;
      }
      getScreenshotBlobUrl(next, 360, 240)
        .catch(() => {})
        .finally(() => {
          window.setTimeout(runNext, 180);
        });
    };
    runNext();
  };

  if (document.readyState === "complete") {
