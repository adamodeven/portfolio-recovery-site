        const updateSkillsLines = () => {
          const skillItems = skillsList.querySelectorAll(
            ".skills-graph__item[data-skill-id]"
          );
          const projectItems = projectsList.querySelectorAll(
            ".skills-graph__item[data-project-id]"
          );

          if (!skillItems.length || !projectItems.length) {
            linesSvg.replaceChildren();
            return;
          }

          const graphRect = skillsGraph.getBoundingClientRect();
          const width = Math.max(1, Math.round(graphRect.width));
          const height = Math.max(1, Math.round(graphRect.height));
          if (width <= 1 || height <= 1) {
            return;
          }

          const rootStyles = getComputedStyle(document.documentElement);
          const strokeColor =
            rootStyles.getPropertyValue("--about-venn-line").trim() || "#666";
          const lineGap = 15;

          linesSvg.setAttribute("viewBox", `0 0 ${width} ${height}`);
          linesSvg.setAttribute("width", width);
          linesSvg.setAttribute("height", height);
          linesSvg.replaceChildren();

          const skillNodes = new Map();
          skillItems.forEach((item) => {
            const id = item.dataset.skillId;
            if (id) {
              skillNodes.set(id, item);
            }
          });

          const projectNodes = new Map();
          projectItems.forEach((item) => {
            const id = item.dataset.projectId;
            if (id) {
              projectNodes.set(id, item);
            }
          });

          const svgNS = "http://www.w3.org/2000/svg";
          const fragment = document.createDocumentFragment();

          getCurrentSkills().forEach((skill) => {
            const skillId = String(skill.id);
            const skillItem = skillNodes.get(skillId);
            if (!skillItem) {
              return;
            }
            const skillLink = skillItem.querySelector(".skills-graph__link");
            const skillRect = (skillLink || skillItem).getBoundingClientRect();
            const startX = skillRect.right - graphRect.left + lineGap;
            const startY = skillRect.top - graphRect.top + skillRect.height / 2;

            projectData.forEach((project) => {
              const projectItem = projectNodes.get(project.id);
              if (!projectItem) {
                return;
              }
              if (!isProjectConnectedToSkill(project, skillId)) {
                return;
              }

              const projectLink = projectItem.querySelector(".skills-graph__link");
              const projectRect = (projectLink || projectItem).getBoundingClientRect();
              const endX = projectRect.left - graphRect.left - lineGap;
              const endY = projectRect.top - graphRect.top + projectRect.height / 2;

              if (![startX, startY, endX, endY].every(Number.isFinite)) {
                return;
              }

              const line = document.createElementNS(svgNS, "line");
              line.setAttribute("x1", startX);
              line.setAttribute("y1", startY);
              line.setAttribute("x2", endX);
              line.setAttribute("y2", endY);
              line.setAttribute("stroke", strokeColor);
              line.setAttribute("stroke-width", "1.2");
              line.setAttribute("stroke-linecap", "round");
              line.setAttribute("class", "skills-graph__line");
              line.dataset.skillId = skillId;
              line.dataset.projectId = project.id;
              fragment.appendChild(line);
            });
          });

          linesSvg.appendChild(fragment);
        };

        const scheduleSkillsUpdate = () => {
          if (skillsGraphFrame) {
            cancelAnimationFrame(skillsGraphFrame);
          }
          skillsGraphFrame = requestAnimationFrame(updateSkillsLines);
        };

        skillsList.addEventListener("click", (event) => {
          const link = event.target.closest(".skills-graph__link");
          if (!link) {
            return;
          }

          if (link.dataset.action === "back") {
            event.preventDefault();
            currentMode = "top";
            activeParentId = null;
            skillsList.classList.remove("skills-graph__list--visible");
            window.setTimeout(() => {
              renderSkillsList({ animate: true });
              clearActiveState();
              updateParentProjectFilter();
              scheduleSkillsUpdate();
            }, 160);
            return;
          }

          const skillId = link.dataset.skillId;
          const hasChildren = link.dataset.hasChildren === "true";
          const isStatic = link.dataset.static === "true";

          if (currentMode === "top" && hasChildren && skillId) {
            event.preventDefault();
            currentMode = "sub";
            activeParentId = skillId;
            skillsList.classList.remove("skills-graph__list--visible");
            window.setTimeout(() => {
              renderSkillsList({ animate: true });
              clearActiveState();
              updateParentProjectFilter();
              scheduleSkillsUpdate();
            }, 160);
            return;
          }

          if (isStatic) {
            event.preventDefault();
          }
        });

        bindProjectHover();
        renderSkillsList({ animate: true });
        updateParentProjectFilter();
        scheduleSkillsUpdate();

        window.addEventListener("resize", scheduleSkillsUpdate);
        window.addEventListener("scroll", scheduleSkillsUpdate, { passive: true });
      }
    }
  }

