        const cleaned = content.cloneNode(true);
        cleaned
          .querySelectorAll(
            "img, picture, figure, video, iframe, svg, .wp-block-image, .wp-block-video"
          )
          .forEach((node) => node.remove());
        const paragraphs = Array.from(cleaned.querySelectorAll("p")).slice(0, 2);
        preview.innerHTML = paragraphs.length
          ? paragraphs.map((p) => p.outerHTML).join("")
          : cleaned.innerHTML;
        card.dataset.previewLoaded = "done";
