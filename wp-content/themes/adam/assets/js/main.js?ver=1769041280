    card.dataset.previewLoaded = "loading";
    fetch(url, { credentials: "same-origin" })
      .then((res) => res.text())
      .then((html) => {
        const doc = previewParser.parseFromString(html, "text/html");
        let content = doc.querySelector(".content-centered article > div");
        if (!content) {
          content = doc.querySelector("main");
        }
        if (!content) {
          card.dataset.previewLoaded = "";
          return;
