  const aboutPage = document.querySelector(".about-page");
  const aboutDiagram = document.querySelector(".about-venn__diagram");
  const aboutContent = document.querySelector(".about-content");
  const aboutConnector = document.querySelector(".about-connector");
  let aboutConnectorFrame = null;

  const getArrowLineEnd = (startX, startY, endX, endY, arrowLength) => {
    if (!Number.isFinite(arrowLength) || arrowLength <= 0) {
      return { x: endX, y: endY };
    }
    const dx = endX - startX;
    const dy = endY - startY;
    const length = Math.hypot(dx, dy);
    if (!Number.isFinite(length) || length <= arrowLength) {
      return { x: endX, y: endY };
    }
    const scale = (length - arrowLength) / length;
    return { x: startX + dx * scale, y: startY + dy * scale };
  };

  const updateAboutConnector = () => {
    if (!aboutPage || !aboutDiagram || !aboutContent || !aboutConnector) {
      return;
    }

    const pageRect = aboutPage.getBoundingClientRect();
    const diagramRect = aboutDiagram.getBoundingClientRect();
    const contentRect = aboutContent.getBoundingClientRect();
    const diagramStyles = getComputedStyle(aboutDiagram);
    const circleSizeValue = parseFloat(diagramStyles.getPropertyValue("--circle-size"));
    const circle = aboutDiagram.querySelector(".about-venn__circle");
    const circleRect = circle ? circle.getBoundingClientRect() : null;
    const circleSize = Number.isFinite(circleSizeValue) && circleSizeValue > 0
      ? circleSizeValue
      : (circleRect ? circleRect.height : diagramRect.height);

    const startX = diagramRect.left + diagramRect.width / 2 - pageRect.left;
    const startYOffset = Math.min(50, circleSize * 0.2);
    const startTop = circleRect ? circleRect.top : diagramRect.top;
    const startY = startTop + circleSize * 0.48 - pageRect.top + startYOffset;
    const endX = contentRect.left - pageRect.left + 30;
    const endY = contentRect.top - pageRect.top;

    const width = Math.max(1, Math.round(pageRect.width));
    const height = Math.max(1, Math.round(pageRect.height));
    if (width <= 1 || height <= 1) {
      return;
    }

    const rootStyles = getComputedStyle(document.documentElement);
    const strokeColor = rootStyles
      .getPropertyValue("--about-venn-line")
      .trim() || "#666";
    const scrollbarArrow = parseFloat(rootStyles.getPropertyValue("--scrollbar-arrow"));
    const arrowLength = Number.isFinite(scrollbarArrow) && scrollbarArrow > 0
      ? scrollbarArrow
      : 8;
    const arrowWidth = Math.max(1, Math.round(arrowLength * 1.5));
    const lineEnd = getArrowLineEnd(startX, startY, endX, endY, arrowLength);

    const svgNS = "http://www.w3.org/2000/svg";
    const lineId = "about-arrow";

    aboutConnector.setAttribute("xmlns", svgNS);
    aboutConnector.setAttribute("viewBox", `0 0 ${width} ${height}`);
    aboutConnector.setAttribute("width", width);
    aboutConnector.setAttribute("height", height);

    aboutConnector.replaceChildren();

    const defs = document.createElementNS(svgNS, "defs");
    const marker = document.createElementNS(svgNS, "marker");
    marker.setAttribute("id", lineId);
    marker.setAttribute("markerUnits", "userSpaceOnUse");
    marker.setAttribute("markerWidth", String(arrowLength));
    marker.setAttribute("markerHeight", String(arrowWidth));
    marker.setAttribute("refX", "0");
    marker.setAttribute("refY", String(arrowWidth / 2));
    marker.setAttribute("orient", "auto");

    const markerPath = document.createElementNS(svgNS, "path");
    markerPath.setAttribute(
      "d",
      `M0 0 L${arrowLength} ${arrowWidth / 2} L0 ${arrowWidth} Z`
    );
    markerPath.setAttribute("fill", strokeColor);
    markerPath.setAttribute("stroke", "none");
    marker.appendChild(markerPath);
    defs.appendChild(marker);

    const line = document.createElementNS(svgNS, "line");
    line.setAttribute("x1", startX);
    line.setAttribute("y1", startY);
    line.setAttribute("x2", lineEnd.x);
    line.setAttribute("y2", lineEnd.y);
    line.setAttribute("stroke", strokeColor);
    line.setAttribute("stroke-width", "1.2");
    line.setAttribute("stroke-linecap", "round");
    line.setAttribute("marker-end", `url(#${lineId})`);

    aboutConnector.appendChild(defs);
    aboutConnector.appendChild(line);
  };

  if (aboutConnector) {
    updateAboutConnector();
    requestAnimationFrame(updateAboutConnector);
    window.addEventListener("resize", () => {
      if (aboutConnectorFrame) {
        cancelAnimationFrame(aboutConnectorFrame);
      }
      aboutConnectorFrame = requestAnimationFrame(updateAboutConnector);
    });
    window.addEventListener("scroll", () => {
      if (aboutConnectorFrame) {
        cancelAnimationFrame(aboutConnectorFrame);
      }
      aboutConnectorFrame = requestAnimationFrame(updateAboutConnector);
    }, { passive: true });
