    const width = Math.max(1, Math.round(pageRect.width));
    const height = Math.max(1, Math.round(pageRect.height));
    if (width <= 1 || height <= 1) {
      return;
    }

    const rootStyles = getComputedStyle(document.documentElement);
    const strokeColor = rootStyles
      .getPropertyValue("--about-venn-line")
      .trim() || "#666";
    const scrollbarArrow = parseFloat(rootStyles.getPropertyValue("--scrollbar-arrow"));
    const arrowLength = Number.isFinite(scrollbarArrow) && scrollbarArrow > 0
      ? scrollbarArrow
      : 8;
    const arrowWidth = Math.max(1, Math.round(arrowLength * 1.5));
    const lineEnd = getArrowLineEnd(startX, startY, endX, endY, arrowLength);

    const svgNS = "http://www.w3.org/2000/svg";
    const lineId = "hero-arrow";

    heroConnector.setAttribute("xmlns", svgNS);
    heroConnector.setAttribute("viewBox", `0 0 ${width} ${height}`);
    heroConnector.setAttribute("width", width);
    heroConnector.setAttribute("height", height);

    heroConnector.replaceChildren();

    const defs = document.createElementNS(svgNS, "defs");
    const marker = document.createElementNS(svgNS, "marker");
    marker.setAttribute("id", lineId);
    marker.setAttribute("markerUnits", "userSpaceOnUse");
    marker.setAttribute("markerWidth", String(arrowLength));
    marker.setAttribute("markerHeight", String(arrowWidth));
    marker.setAttribute("refX", "0");
    marker.setAttribute("refY", String(arrowWidth / 2));
    marker.setAttribute("orient", "auto");

    const markerPath = document.createElementNS(svgNS, "path");
    markerPath.setAttribute(
      "d",
      `M0 0 L${arrowLength} ${arrowWidth / 2} L0 ${arrowWidth} Z`
    );
    markerPath.setAttribute("fill", strokeColor);
    markerPath.setAttribute("stroke", "none");
    marker.appendChild(markerPath);
    defs.appendChild(marker);

    const line = document.createElementNS(svgNS, "line");
    line.setAttribute("x1", startX);
    line.setAttribute("y1", startY);
    line.setAttribute("x2", lineEnd.x);
    line.setAttribute("y2", lineEnd.y);
    line.setAttribute("stroke", strokeColor);
    line.setAttribute("stroke-width", "1.2");
    line.setAttribute("stroke-linecap", "round");
    line.setAttribute("marker-end", `url(#${lineId})`);

    heroConnector.appendChild(defs);
    heroConnector.appendChild(line);
  };

  if (heroConnector) {
    updateHeroConnector();
    requestAnimationFrame(updateHeroConnector);
    window.addEventListener("resize", () => {
      if (heroConnectorFrame) {
        cancelAnimationFrame(heroConnectorFrame);
      }
      heroConnectorFrame = requestAnimationFrame(updateHeroConnector);
    });
    window.addEventListener("scroll", () => {
      if (heroConnectorFrame) {
        cancelAnimationFrame(heroConnectorFrame);
      }
      heroConnectorFrame = requestAnimationFrame(updateHeroConnector);
    }, { passive: true });
  }

  const updateFns = [];

  if (hero && header) {
    document.body.classList.add("has-hero");
    updateFns.push(() => {
      const scrollTop = window.scrollY || window.pageYOffset;
      let progress = 0;
      if (cards.length >= 2 && firstCard) {
        const triggerPoint = window.innerHeight * 0.6;
        const firstRect = firstCard.getBoundingClientRect();
        const firstCenterAbs =
          firstRect.top + scrollTop + firstRect.height / 2;
        const lastCard = cards[cards.length - 1];
        const lastRect = lastCard.getBoundingClientRect();
        const lastCenterAbs =
          lastRect.top + scrollTop + lastRect.height / 2;
        const startScroll = firstCenterAbs - triggerPoint;
        const endScroll = lastCenterAbs - triggerPoint;
        const span = Math.max(1, endScroll - startScroll);
        progress = (scrollTop - startScroll) / span;
      } else {
        const start = grid ? grid.offsetTop : 0;
        const total = grid ? grid.scrollHeight - window.innerHeight : 0;
        progress = total > 0 ? (scrollTop - start) / total : 0;
      }
      progress = Math.min(1, Math.max(0, progress));

      if (scrollbar) {
        const isMobile = mobileQuery ? mobileQuery.matches : false;

        if (isMobile) {
          scrollbar.classList.remove(
            "project-scrollbar--start",
            "project-scrollbar--middle",
            "project-scrollbar--end"
          );
          let state = "middle";
          if (cards.length) {
            const viewportCenter = window.innerHeight / 2;
            let closestIndex = 0;
            let closestDistance = Infinity;
            cards.forEach((card, index) => {
              const rect = card.getBoundingClientRect();
              const cardCenter = rect.top + rect.height / 2;
              const distance = Math.abs(cardCenter - viewportCenter);
              if (distance < closestDistance) {
                closestDistance = distance;
                closestIndex = index;
              }
            });

            if (closestIndex === 0) {
              state = "start";
            } else if (closestIndex === cards.length - 1) {
              state = "end";
            }
          } else if (total <= 0 || progress <= 0.04) {
            state = "start";
          } else if (progress >= 0.96) {
            state = "end";
          }
          scrollbar.classList.add(`project-scrollbar--${state}`);
        } else {
          scrollbar.classList.remove(
            "project-scrollbar--start",
            "project-scrollbar--middle",
            "project-scrollbar--end"
          );
          const available = Math.max(
            0,
            (scrollbar ? scrollbar.clientHeight : 0) - 2 * (padding + arrow)
          );
          const y = padding + arrow + progress * available;
          dot?.style?.setProperty("top", `${y}px`);
        }
      }

      let shouldShow = false;
      if (firstCard) {
        const cardRect = firstCard.getBoundingClientRect();
        const cardCenter = cardRect.top + cardRect.height / 2;
        const triggerPoint = window.innerHeight * 0.6; // start when first card is 10% below center
        shouldShow = cardCenter <= triggerPoint;
      }

      scrollbar?.classList.toggle("project-scrollbar--visible", shouldShow);
      hero?.classList?.toggle("hero--faded", shouldShow);
      header?.classList?.toggle("site-header--visible", shouldShow);
    });
  }

  if (!updateFns.length) {
    if (themeToggle) {
      const updateToggleVisibility = () => {
        const isAtTop = (window.scrollY || window.pageYOffset) <= 0;
        themeToggle.classList.toggle("is-hidden", !isAtTop);
      };
      updateToggleVisibility();
      window.addEventListener("scroll", updateToggleVisibility, { passive: true });
    }
    return;
  }

  let ticking = false;
  const runUpdates = () => {
    updateFns.forEach((fn) => fn());
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      window.requestAnimationFrame(runUpdates);
      ticking = true;
    }
  };

  runUpdates();
  window.addEventListener("scroll", onScroll, { passive: true });

  onScroll();
  window.addEventListener("resize", onScroll);

  if (themeToggle) {
    const updateToggleVisibility = () => {
      const isAtTop = (window.scrollY || window.pageYOffset) <= 0;
      themeToggle.classList.toggle("is-hidden", !isAtTop);
    };
    updateToggleVisibility();
    window.addEventListener("scroll", updateToggleVisibility, { passive: true });
  }
});
